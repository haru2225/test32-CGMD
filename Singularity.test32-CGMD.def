Bootstrap: docker
From: pytorch/pytorch:2.5.0-cuda12.4-cudnn9-runtime

%labels
    Author DM2 test32-CGMD
    Description DM2 NequIP amorphous SiO2 generation and Si-only CG export

%post
    python -m pip install --no-cache-dir \
        "numpy==1.26.4" \
        "pandas>=2.0,<3" \
        "e3nn==0.4.4" \
        "ase>=3.22,<4" \
        "matplotlib>=3.7,<4" \
        "scikit-learn>=1.3,<2" \
        "scipy>=1.10,<2" \
        "torch-geometric>=2.5,<3" \
        "tqdm>=4.65,<5" \
        "lammps>=2024.8.0"

%environment
    export MPLBACKEND=Agg
    export PYTHONUNBUFFERED=1
    export PYTHONNOUSERSITE=1

%runscript
    exec python "$@"

%test
    python -c "import torch, numpy, pandas, ase, e3nn, matplotlib, sklearn, scipy, torch_geometric, lammps; print('torch:', torch.__version__); print('CUDA build:', torch.version.cuda)"
